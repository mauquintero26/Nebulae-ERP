# Nebulae ERP-CRM — Variables de entorno requeridas
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env con credenciales reales.

# Base de datos de producción
DATABASE_URL=postgresql://db_user:your_password_here@your_host:5432/erpdb?sslmode=disable

# Base de datos de tests (debe ser una DB separada, NO la de producción)
TEST_DATABASE_URL=postgresql://db_user:your_password_here@your_host:5432/erp_test?sslmode=disable

# IP/hostname del VPS de producción (para el check de seguridad en conftest.py)
PROD_VPS_HOST=your.vps.host.here

# JWT
SECRET_KEY=your_random_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
